# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ=Africa/Lagos
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/uchecut
# Separate database for integration tests (created/migrated automatically by Jest)
TEST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/uchecut_test

# --- Seed: first OWNER admin ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Shop Owner

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Victory Barbershop <bookings@example.com>"

# --- SMS (Termii) ---
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- Notifications ---
# log: messages are written to the log and the Notification table only (default outside production)
# live: sent via SMTP/Termii (default in production; needs the SMTP_* and TERMII_* values above)
NOTIFY_MODE=log
# Outside production, live mode only messages these recipients (comma separated phones/emails)
NOTIFY_ALLOWLIST=
# Owner alerts (new booking, home request, cancellation); defaults to the shop email in Settings
OWNER_EMAIL=

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent  (default: info; silent in tests)
LOG_LEVEL=info
