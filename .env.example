# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TZ=Africa/Lagos
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/uchecut
# Separate database for integration tests (created/migrated automatically by Jest)
TEST_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/uchecut_test

# --- Seed: first OWNER admin ---
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Shop Owner

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Victory Barbershop <bookings@example.com>"

# --- SMS (Termii) --- optional. With no keys, SMS is off and customers are messaged by email.
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# Force SMS on/off regardless of the keys (blank = on only when both keys are set)
SMS_ENABLED=

# --- Notifications ---
# log: messages are written to the log and the Notification table only (default outside production)
# live: sent via SMTP (and Termii when SMS is on); default in production
NOTIFY_MODE=log
# Outside production, live mode only messages these recipients (comma separated phones/emails)
NOTIFY_ALLOWLIST=
# Owner alerts (new booking, home request, cancellation); defaults to the shop email in Settings
OWNER_EMAIL=

# --- Images (Cloudinary) ---
# From the Cloudinary console: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Server-side only; the browser only ever sees res.cloudinary.com delivery URLs.
# Empty in dev = pages use the bundled photos and admin uploads say "not set up".
CLOUDINARY_URL=
# Uploads go to {folder}/{gallery|barbers|services|products|site}.
# Default victory/dev (victory/prod in production; production refuses a folder without "prod").
CLOUDINARY_FOLDER=victory/dev

# --- Demo recordings only (npm run record:demo sets it; refused in production) ---
# 1 hides setup-only UI such as the owner's "Before you launch" checklist.
DEMO_MODE=

# --- Logging ---
# fatal | error | warn | info | debug | trace | silent  (default: info; silent in tests)
LOG_LEVEL=info
