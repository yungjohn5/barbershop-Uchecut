<% const inFlow = page === 'book' || page === 'manage'; -%>
<!doctype html>
<html lang="en-NG" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <% const seo = locals.seo || {}; const fullTitle = title ? `${title} · ${shop.name}` : `${shop.name} · Barbershop in Lagos`; const desc = locals.description || shop.tagline; -%>
    <title><%= fullTitle %></title>
    <meta name="description" content="<%= desc %>" />
    <% if (seo.noindex || locals.noindex) { %><meta name="robots" content="noindex, nofollow" />
    <% } else if (seo.canonical) { %><link rel="canonical" href="<%= seo.canonical %>" />
    <% } -%>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="<%= shop.name %>" />
    <meta property="og:locale" content="en_NG" />
    <meta property="og:title" content="<%= fullTitle %>" />
    <meta property="og:description" content="<%= desc %>" />
    <% if (seo.canonical) { %><meta property="og:url" content="<%= seo.canonical %>" /><% } %>
    <% if (seo.image) { %>
    <meta property="og:image" content="<%= seo.image.url %>" />
    <meta property="og:image:width" content="<%= seo.image.width %>" />
    <meta property="og:image:height" content="<%= seo.image.height %>" />
    <meta property="og:image:alt" content="<%= shop.name %>, barbershop in Lagos" />
    <meta name="twitter:image" content="<%= seo.image.url %>" />
    <% } %>
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= fullTitle %>" />
    <meta name="twitter:description" content="<%= desc %>" />
    <meta name="theme-color" content="#F4F1EC" data-theme-color />
    <link rel="icon" href="/icons/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <% if (seo.jsonLd) { %><script type="application/ld+json"><%- seoJson(seo.jsonLd) %></script><% } %>
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <script src="<%= asset('/js/boot.js') %>"></script>
    <%# Self-hosted fonts (@font-face in app.css); the two first-screen faces load early. %>
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/gloock-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="<%= asset('/css/app.css') %>" />
  </head>
  <body class="min-h-screen overflow-x-clip" <%- inFlow ? 'data-no-smoother' : '' %>>
    <a href="#main" class="sr-only z-[60] rounded-full bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:left-3 focus:top-3">Skip to content</a>

    <% if (!inFlow) { %><%- include('../partials/sticky-nav') %><% } %>
    <%- include('../partials/mobile-menu') %>
    <% if (page !== 'home') { %><%- include('../partials/nav', { variant: 'dark' }) %><% } %>

    <% if (page === 'home') { %>
      <%# First-visit intro (shown by boot.js only when motion is allowed). %>
      <div class="keep-dark loader fixed inset-0 z-[70] place-items-center bg-ink text-paper" aria-hidden="true" data-loader>
        <img src="/images/brand/mark.webp" alt="" width="240" height="260" class="loader-mark" />
        <div class="overflow-hidden"><span class="block font-serif text-[22vw] leading-[0.9] lg:text-[16vw]" data-loader-word><%= shop.name.split(' ')[0] %></span></div>
        <span class="absolute bottom-6 left-6 text-[0.7rem] uppercase tracking-[0.3em] text-paper/60 sm:bottom-10 sm:left-10">Barbershop · Lagos</span>
        <span class="absolute bottom-4 right-6 font-accent text-6xl italic tabular-nums text-amber-light sm:bottom-8 sm:right-10 sm:text-8xl" data-loader-count>0</span>
      </div>
    <% } %>

    <%# Desktop smooth scrolling wraps page content; fixed UI stays outside. %>
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <main id="main"><%- body %></main>
        <% if (inFlow) { %><%- include('../partials/footer-slim') %><% } else { %><%- include('../partials/footer') %><% } %>
      </div>
    </div>

    <% if (!inFlow) { %>
    <button type="button" class="to-top" aria-label="Back to top" data-to-top data-magnetic>
      <svg class="to-top-ring" viewBox="0 0 52 52" aria-hidden="true">
        <circle class="to-top-track" cx="26" cy="26" r="24.5" />
        <circle class="to-top-progress" cx="26" cy="26" r="24.5" pathLength="1" />
      </svg>
      <span class="to-top-arrow" aria-hidden="true"><span>↑</span><span>↑</span></span>
    </button>

    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-[140%] p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] transition-transform duration-500 ease-expo md:hidden [&.is-visible]:translate-y-0" data-book-pill>
      <a href="/book" class="btn-primary pointer-events-auto w-full py-3.5 shadow-[0_18px_40px_-12px_rgba(20,20,20,0.55)]">
        Book now <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <% } %>

    <script src="<%= asset('/vendor/gsap/gsap.min.js') %>" defer></script>
    <script src="<%= asset('/vendor/gsap/ScrollTrigger.min.js') %>" defer></script>
    <script src="<%= asset('/vendor/gsap/SplitText.min.js') %>" defer></script>
    <script src="<%= asset('/vendor/gsap/Flip.min.js') %>" defer></script>
    <script src="<%= asset('/vendor/gsap/ScrollSmoother.min.js') %>" defer></script>
    <script src="<%= asset('/js/site.js') %>" defer></script>
    <% if (page === 'home') { %><script src="<%= asset('/js/home.js') %>" defer></script><% } %>
    <% if (inFlow) { %><script src="<%= asset('/js/booking.js') %>" defer></script><% } %>
  </body>
</html>
