<!doctype html>
<html lang="en-NG">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title ? `${title} · ${shop.name}` : `${shop.name} · Lagos` %></title>
    <meta name="description" content="<%= shop.tagline %>" />
    <meta name="csrf-token" content="<%= csrfToken %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Gloock&family=Inter:wght@400;500;600&display=swap"
    />
    <link rel="stylesheet" href="/css/app.css" />
  </head>
  <body class="min-h-screen flex flex-col">
    <%- include('../partials/nav') %>
    <main class="flex-1"><%- body %></main>
    <%- include('../partials/footer') %>
  </body>
</html>
