<section class="mx-auto max-w-[88rem] px-5 pb-40 pt-6 sm:px-8 lg:px-10 lg:pb-28 lg:pt-10">
  <%- include('../partials/booking/steps') %>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-14 xl:grid-cols-[minmax(0,1fr)_24rem]">
    <div>
      <%- include('../partials/booking/flash') %>
      <p class="eyebrow" data-b-reveal><span class="eyebrow-num">02</span>Services</p>
      <h1 class="mt-4 text-[clamp(2.2rem,4.4vw,3.75rem)] leading-[1.02]" data-b-reveal>What are we <em class="accent">doing</em> today?</h1>
      <p class="mt-4 max-w-xl text-[1.02rem] text-ink/70" data-b-reveal>
        Choose one or more. <% if (ctx.type === 'HOME') { %>Only services that travel well are shown for home visits.<% } else { %>Prices are fixed and shown upfront.<% } %>
      </p>

      <form id="step-form" method="post" action="/book/services" class="mt-10" data-services-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% ctx.categories.forEach((c) => { %>
          <fieldset class="mt-10 first:mt-0" data-b-reveal>
            <legend class="text-sm font-medium uppercase tracking-[0.16em] text-ink/65"><%= c.name %></legend>
            <div class="mt-4 grid gap-3 md:grid-cols-2">
              <% c.services.forEach((s) => { %>
                <label class="choice choice-service group">
                  <input type="checkbox" name="serviceIds" value="<%= s.id %>" class="sr-only" data-name="<%= s.name %>" data-price="<%= s.priceKobo %>" data-duration="<%= s.durationMin %>" <%= ctx.chosenIds.includes(s.id) ? 'checked' : '' %> />
                  <% if (imageOf(s)) { %>
                    <span class="block h-16 w-16 shrink-0 overflow-hidden rounded-[0.75rem] min-[400px]:h-20 min-[400px]:w-20 sm:h-24 sm:w-24">
                      <img src="<%= imageUrl(imageOf(s), { w: 400, h: 400 }) %>" alt="" class="h-full w-full object-cover transition-transform duration-[1.2s] ease-expo group-hover:scale-[1.06]" loading="lazy" />
                    </span>
                  <% } %>
                  <span class="min-w-0 flex-1">
                    <span class="flex items-start justify-between gap-3">
                      <span class="font-medium leading-snug"><%= s.name %></span>
                      <span class="choice-check shrink-0" aria-hidden="true"></span>
                    </span>
                    <span class="mt-1 block text-sm tabular-nums text-ink/65"><%= naira(s.priceKobo) %> · <%= duration(s.durationMin) %></span>
                    <% if (s.description) { %><span class="mt-1.5 block text-sm leading-relaxed text-ink/65"><%= s.description %></span><% } %>
                  </span>
                </label>
              <% }) %>
            </div>
          </fieldset>
        <% }) %>

        <div class="mt-12 hidden items-center justify-between gap-4 lg:flex">
          <a href="/book" class="link-line text-sm"><span class="link-arrow rotate-180" aria-hidden="true">→</span> Back</a>
          <button type="submit" class="btn-primary" data-continue <%= ctx.chosenIds.length ? '' : 'disabled' %>>Choose a time <span class="arrow" aria-hidden="true">→</span></button>
        </div>
      </form>
    </div>

    <%- include('../partials/booking/summary', { cta: 'Choose a time', canContinue: ctx.chosenIds.length > 0 }) %>
  </div>
</section>
