<% const statusText = { PENDING: 'Awaiting confirmation', CONFIRMED: 'Confirmed', COMPLETED: 'Completed', CANCELLED: 'Cancelled', NO_SHOW: 'Missed' }; %>
<% const wa = encodeURIComponent(`Hi ${shop.name}, about my booking ${booking.reference}.`); %>
<section class="mx-auto max-w-5xl px-5 pb-28 pt-8 sm:px-8 lg:pt-14">
  <%- include('../partials/booking/flash') %>

  <div class="flex flex-wrap items-end justify-between gap-6" data-b-reveal>
    <div>
      <p class="eyebrow">Manage booking</p>
      <h1 class="mt-4 text-[clamp(2.2rem,4.6vw,3.75rem)] leading-[1.02]">Hello, <em class="accent"><%= booking.customer.name.split(' ')[0] %></em>.</h1>
    </div>
    <div class="flex items-center gap-3">
      <span class="status-badge status-<%= booking.status.toLowerCase() %>"><span class="status-dot <%= booking.status === 'CONFIRMED' ? 'is-open' : '' %>" aria-hidden="true"></span><%= statusText[booking.status] %></span>
      <span class="font-mono text-sm text-ink/65"><%= booking.reference %></span>
    </div>
  </div>

  <div class="mt-10 rounded-[1.25rem] border border-ink/10 bg-surface p-6 sm:p-9" data-b-reveal>
    <%- include('../partials/booking/details-card') %>
  </div>

  <% if (check.allowed) { %>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap" data-b-reveal>
      <a href="/manage/<%= booking.manageToken %>/reschedule" class="btn-primary">Reschedule <span class="arrow" aria-hidden="true">→</span></a>
      <button type="button" class="btn-ghost" data-dialog-open="cancel-dialog">Cancel booking</button>
      <a href="/manage/<%= booking.manageToken %>/calendar.ics" class="btn-ghost">Add to calendar</a>
    </div>
    <p class="mt-5 text-sm text-ink/65" data-b-reveal>You can change or cancel online until <%= cutoffMin / 60 %> hours before your appointment.</p>

    <dialog id="cancel-dialog" class="b-dialog" aria-labelledby="cancel-title">
      <form method="post" action="/manage/<%= booking.manageToken %>/cancel">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <p class="eyebrow">Cancel booking</p>
        <h2 id="cancel-title" class="mt-4 text-4xl">Cancel <%= day %>?</h2>
        <p class="mt-3 text-ink/70">Your <%= time %> slot will be released for someone else. This can’t be undone, but you can always book again.</p>
        <div class="field-float mt-6">
          <textarea id="f-reason" name="reason" rows="2" placeholder=" " maxlength="300"></textarea>
          <label for="f-reason">Reason <span class="font-normal opacity-70">(optional)</span></label>
        </div>
        <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <button type="button" class="btn-ghost" data-dialog-close>Keep my booking</button>
          <button type="submit" class="btn-primary">Yes, cancel it</button>
        </div>
      </form>
    </dialog>
  <% } else { %>
    <div class="locked-note mt-8" data-b-reveal>
      <p class="font-medium"><%= check.reason %></p>
      <div class="mt-5 flex flex-col gap-3 sm:flex-row">
        <a href="tel:<%= shop.phone %>" class="btn-ghost">Call <%= fmtPhone(shop.phone) %></a>
        <a href="https://wa.me/<%= shop.whatsapp %>?text=<%= wa %>" rel="noopener" class="btn-ghost">WhatsApp us</a>
        <% if (booking.status === 'CANCELLED' || booking.status === 'COMPLETED') { %><a href="/book" class="btn-primary">Book again <span class="arrow" aria-hidden="true">→</span></a><% } %>
      </div>
    </div>
  <% } %>
</section>
