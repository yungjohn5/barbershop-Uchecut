<%# Temporary page behind every "Book" CTA until the booking wizard ships (Phase 3). %>
<% const what = type === 'HOME' ? 'a home visit' : 'your chair'; %>
<% const message = encodeURIComponent(`Hi ${shop.name}, I'd like to book ${type === 'HOME' ? 'a home visit' : 'an appointment'}.`); %>
<section class="mx-auto grid max-w-[88rem] gap-12 px-5 pb-24 pt-12 sm:px-8 lg:grid-cols-12 lg:px-10 lg:pt-20">
  <div class="lg:col-span-7">
    <p class="eyebrow">Booking</p>
    <h1 class="mt-5 text-title" data-split>Online booking opens shortly.</h1>
    <p class="mt-6 max-w-lg text-[1.05rem] leading-relaxed text-ink/70" data-reveal>
      We’re putting the finishing touches on online booking. Until then, message or call us and we’ll hold <%= what %>.
    </p>
    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
      <a href="https://wa.me/<%= shop.whatsapp %>?text=<%= message %>" rel="noopener" class="btn-primary">Book on WhatsApp <span class="arrow" aria-hidden="true">→</span></a>
      <a href="tel:<%= shop.phone %>" class="btn-ghost">Call <%= shop.phone %></a>
    </div>
  </div>
  <div class="border-t border-ink/10 pt-8 lg:col-span-4 lg:col-start-9 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0" data-reveal>
    <p class="eyebrow">Hours</p>
    <ul class="mt-4 space-y-1.5"><% shop.hoursText.forEach((l) => { %><li><%= l %></li><% }) %></ul>
    <a href="/#services" class="mt-8 inline-flex border-b border-ink/30 pb-1 text-sm font-medium hover:border-amber">See services &amp; prices →</a>
  </div>
</section>
