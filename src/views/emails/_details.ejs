<%# Booking facts table + manage button. Uses p (payload). Param: cta (label), ctaUrl %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:22px 0;border:1px solid #eee6da;border-radius:14px;">
  <tr><td style="padding:16px 18px;font-size:15px;line-height:1.7;">
    <strong style="display:block;font-family:Georgia,'Times New Roman',serif;font-size:20px;font-weight:normal;"><%= p.day %></strong>
    <%= p.time %> – <%= p.endTime %><br />
    <% if (p.type === 'HOME') { %>Home visit<%= p.zone ? ` · ${p.zone}` : '' %><br /><%= p.address %><% if (p.landmark) { %><br />Landmark: <%= p.landmark %><% } %><% } else { %>At the shop<% if (p.shopAddress && p.shopAddress.length) { %> · <%= p.shopAddress.join(', ') %><% } %><% } %><br />
    With <%= p.barber %><br />
    <%= p.services.join(', ') %><br />
    <strong>Total, paid on the day: <%= naira(p.totalKobo) %></strong><% if (p.homeFeeKobo) { %> (incl. <%= naira(p.homeFeeKobo) %> travel)<% } %><br />
    <span style="color:#6b5846;">Reference <strong style="color:#141414;letter-spacing:1px;"><%= p.reference %></strong></span>
  </td></tr>
</table>
<p style="margin:0 0 8px;">
  <a href="<%= locals.ctaUrl || p.manageUrl %>" style="display:inline-block;background:#b8833e;color:#141414;text-decoration:none;font-weight:bold;padding:12px 22px;border-radius:999px;"><%= locals.cta || 'View or change your booking' %></a>
</p>
<p style="margin:12px 0 0;font-size:13px;color:#6b5846;">Your manage link: <a href="<%= p.manageUrl %>" style="color:#9a6c31;word-break:break-all;"><%= p.manageUrl %></a></p>
