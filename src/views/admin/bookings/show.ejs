<% const wa = `https://wa.me/${booking.customer.phone.replace(/^\+/, '')}`; %>
<nav class="text-sm text-ink/65" aria-label="Breadcrumb"><a href="/admin/bookings" class="link-u">Bookings</a> <span aria-hidden="true">/</span> <%= booking.reference %></nav>
<header class="a-page-head">
  <div>
    <div class="flex flex-wrap items-center gap-3">
      <p class="font-mono text-sm text-ink/65"><%= booking.reference %></p>
      <%- include('../partials/status', { status: booking.status }) %>
      <span class="a-type a-type-<%= booking.type.toLowerCase() %>"><%= booking.type === 'HOME' ? 'Home visit' : 'In shop' %></span>
      <% if (booking.source === 'STAFF') { %><span class="a-type">Booked by staff</span><% } %>
    </div>
    <h1 class="a-title mt-3"><%= booking.customer.name %></h1>
    <p class="mt-1 text-ink/70"><%= when %></p>
  </div>
  <%- include('../partials/actions', { booking, actions, size: 'md' }) %>
</header>

<div class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-6">
    <div class="a-card">
      <%- include('../../partials/booking/details-card') %>
    </div>

    <div class="a-card">
      <h2 class="a-h3">Notes</h2>
      <% if (booking.notes) { %>
        <div class="mt-4 rounded-xl bg-paper-deep/70 p-4 text-[0.95rem]">
          <p class="text-xs uppercase tracking-[0.16em] text-ink/65">From the customer</p>
          <p class="mt-1 whitespace-pre-line"><%= booking.notes %></p>
        </div>
      <% } %>
      <form method="post" action="/admin/bookings/<%= booking.id %>/notes" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field-float">
          <textarea id="staff-notes" name="staffNotes" rows="3" placeholder=" " maxlength="2000"><%= booking.staffNotes || '' %></textarea>
          <label for="staff-notes">Staff notes (only visible here)</label>
        </div>
        <button type="submit" class="btn-ghost mt-3">Save notes</button>
      </form>
    </div>

    <% if (booking.status === 'CANCELLED') { %>
      <div class="a-card">
        <h2 class="a-h3">Cancellation</h2>
        <p class="mt-2 text-ink/75"><%= booking.cancelReason || 'No reason given.' %></p>
        <% if (booking.cancelledAt) { %><p class="mt-1 text-sm text-ink/65"><%= formatShort(booking.cancelledAt) %> · <%= formatTime(booking.cancelledAt) %></p><% } %>
      </div>
    <% } %>
  </div>

  <aside class="space-y-6">
    <div class="a-card">
      <h2 class="a-h3">Customer</h2>
      <p class="mt-3 font-medium"><%= booking.customer.name %></p>
      <p class="text-ink/70"><%= fmtPhone(booking.customer.phone) %></p>
      <% if (booking.customer.email) { %><p class="text-ink/70 break-all"><%= booking.customer.email %></p><% } %>
      <div class="mt-3 flex flex-wrap gap-2 text-xs">
        <a href="/admin/customers/<%= booking.customer.id %>" class="a-type hover:border-ink/40"><%= customerStats.visits %> booking<%= customerStats.visits === 1 ? '' : 's' %></a>
        <% if (booking.customer.noShowCount) { %><span class="a-type a-type-warn"><%= booking.customer.noShowCount %> no-show<%= booking.customer.noShowCount > 1 ? 's' : '' %></span><% } %>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-2">
        <a href="tel:<%= booking.customer.phone %>" class="btn-ghost justify-center !px-3">Call</a>
        <a href="<%= wa %>" rel="noopener" class="btn-ghost justify-center !px-3">WhatsApp</a>
      </div>
    </div>

    <div class="a-card">
      <h2 class="a-h3">Customer’s manage link</h2>
      <p class="mt-2 text-sm text-ink/65">Send this if they need to reschedule or cancel themselves.</p>
      <div class="mt-3 flex items-center gap-2">
        <p class="min-w-0 flex-1 truncate font-mono text-xs text-ink/75" title="<%= manageUrl %>"><%= manageUrl %></p>
        <button type="button" class="btn-ghost shrink-0 !min-h-[2.4rem] !px-4 !py-2 text-sm" data-copy="<%= manageUrl %>"><span data-copy-label>Copy</span></button>
      </div>
    </div>

    <% [['Upcoming', upcoming], ['Past visits', past]].forEach(([label, list]) => { if (!list.length) return; %>
      <div class="a-card">
        <h2 class="a-h3"><%= label %></h2>
        <ul class="mt-3 divide-y divide-ink/10">
          <% list.forEach((h) => { %>
            <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
              <a href="/admin/bookings/<%= h.id %>" class="min-w-0 hover:underline">
                <span class="block font-medium"><%= formatShort(h.startsAt) %> · <%= formatTime(h.startsAt) %></span>
                <span class="block truncate text-ink/65"><%= h.services.map((s) => s.name).join(', ') %></span>
              </a>
              <%- include('../partials/status', { status: h.status }) %>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>

    <div class="a-card">
      <h2 class="a-h3">Messages</h2>
      <%
        const nLabel = { 'shop-confirmed': 'Booking confirmed', 'home-received': 'Request received', 'home-confirmed': 'Home visit confirmed', 'reminder-24h': '24 h reminder', 'reminder-2h': '2 h reminder', rescheduled: 'Moved', cancelled: 'Cancelled', 'auto-cancelled': 'Auto-cancelled', 'owner-new-booking': 'Owner: new booking', 'owner-home-request': 'Owner: home request', 'owner-rescheduled': 'Owner: moved', 'owner-cancelled': 'Owner: cancellation' };
        const nState = (n) => n.status === 'SENT' ? (n.providerRef === 'log' ? ['Logged (not sent)', 'a-type'] : ['Sent', 'a-badge-confirmed']) : n.status === 'PENDING' ? [n.attempts ? `Retrying (${n.attempts} failed)` : 'Queued', 'a-badge-pending'] : n.status === 'FAILED' ? ['Failed', 'a-badge-cancelled'] : ['Skipped', 'a-type'];
      %>
      <% if (!booking.notifications.length) { %><p class="mt-3 text-sm text-ink/65">No messages for this booking.</p><% } %>
      <ul class="mt-3 divide-y divide-ink/10">
        <% booking.notifications.forEach((n) => { const [label, cls] = nState(n); %>
          <li class="a-msg">
            <span class="a-msg-channel" aria-label="<%= n.channel === 'SMS' ? 'SMS' : 'Email' %>"><%= n.channel === 'SMS' ? 'SMS' : '@' %></span>
            <span class="min-w-0 flex-1">
              <span class="block truncate font-medium"><%= nLabel[n.template] || n.template %></span>
              <span class="block truncate text-xs text-ink/60"><%= n.sentAt ? `${formatShort(n.sentAt)} · ${formatTime(n.sentAt)}` : n.status === 'PENDING' ? `From ${formatShort(n.sendAfter)} · ${formatTime(n.sendAfter)}` : '' %><%= n.lastError ? ` · ${n.lastError}` : '' %></span>
            </span>
            <span class="a-badge <%= cls %> shrink-0"><%= label %></span>
            <% if (n.status === 'FAILED') { %>
              <form method="post" action="/admin/notifications/<%= n.id %>/resend" class="shrink-0">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="link-u text-sm">Resend</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="a-card">
      <h2 class="a-h3">History</h2>
      <%
        const who = (e) => (e.actor === 'CUSTOMER' ? 'customer' : e.actor === 'SYSTEM' ? 'system' : e.byName || 'staff');
        const at = (d) => `${formatShort(d)} · ${formatTime(d)}`;
        const label = (e) => {
          switch (e.type) {
            case 'CREATED': return booking.source === 'STAFF' ? `Booked by ${who(e)}` : 'Booked online';
            case 'CONFIRMED': return `Confirmed by ${who(e)}`;
            case 'RESCHEDULED': return `Moved by ${who(e)}`;
            case 'CANCELLED': return `Cancelled by ${who(e)}`;
            case 'COMPLETED': return `Marked completed by ${who(e)}`;
            case 'NO_SHOW': return `Marked no-show by ${who(e)}`;
            case 'RESTORED': return `Restored to confirmed by ${who(e)}`;
            case 'NOTIFY_FAILED': return 'Message failed to send';
            default: return e.type;
          }
        };
      %>
      <ol class="a-history mt-4">
        <% booking.events.forEach((e) => { %>
          <li class="a-history-item a-history-<%= e.type.toLowerCase() %>">
            <p class="font-medium"><%= label(e) %></p>
            <% if (e.type === 'RESCHEDULED' && e.data) { %>
              <p class="text-sm text-ink/70"><%= at(e.data.from) %> → <%= at(e.data.to) %><%= e.data.toBarber && e.data.toBarber !== e.data.fromBarber ? ` · ${e.data.fromBarber} → ${e.data.toBarber}` : '' %></p>
            <% } %>
            <% if (e.note) { %><p class="text-sm text-ink/70"><%= e.note %></p><% } %>
            <p class="text-xs text-ink/55"><%= at(e.createdAt) %></p>
          </li>
        <% }) %>
        <% if (!booking.events.length) { %><li class="text-sm text-ink/65">Created <%= at(booking.createdAt) %></li><% } %>
      </ol>
    </div>
  </aside>
</div>
