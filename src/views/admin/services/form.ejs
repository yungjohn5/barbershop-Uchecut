<% const v = values; const e = errors || {}; const err = (k) => e[k] ? `has-error` : ''; %>
<nav class="text-sm text-ink/65" aria-label="Breadcrumb"><a href="/admin/services" class="link-u">Services</a> <span aria-hidden="true">/</span> <%= service ? service.name : 'New' %></nav>
<header class="a-page-head">
  <div>
    <p class="eyebrow"><%= service ? 'Edit service' : 'New service' %></p>
    <h1 class="a-title"><%= service ? service.name : 'Add a ' %><% if (!service) { %><em class="accent">service</em><% } %></h1>
  </div>
  <% if (service) { %>
    <%- include('../partials/delete', {
      id: `svc-${service.id}`,
      action: `/admin/services/${service.id}/delete`,
      title: `Delete ${service.name}?`,
      body: service._count.bookings ? `It has ${service._count.bookings} booking(s), so it can’t be deleted. Switch “Live on the site” off instead.` : 'It will be removed from the site and the booking wizard.',
      label: 'Delete service',
    }) %>
  <% } %>
</header>

<form method="post" action="/admin/services<%= service ? `/${service.id}` : '' %>" enctype="multipart/form-data" class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]" data-a-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="space-y-6">
    <section class="a-card">
      <h2 class="a-h3">Details</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <label class="a-field sm:col-span-2 <%= err('name') %>"><span>Name</span>
          <input name="name" value="<%= v.name || '' %>" maxlength="60" required placeholder="e.g. Skin Fade" />
          <% if (e.name) { %><p class="field-error"><%= e.name %></p><% } %>
        </label>
        <label class="a-field <%= err('categoryId') %>"><span>Category</span>
          <select name="categoryId">
            <% categories.forEach((c) => { %><option value="<%= c.id %>" <%= Number(v.categoryId) === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
          </select>
          <% if (e.categoryId) { %><p class="field-error"><%= e.categoryId %></p><% } %>
        </label>
        <label class="a-field <%= err('price') %>"><span>Price</span>
          <span class="a-money"><span aria-hidden="true">₦</span><input name="price" inputmode="decimal" value="<%= v.price || '' %>" placeholder="7500" required /></span>
          <% if (e.price) { %><p class="field-error"><%= e.price %></p><% } %>
        </label>
        <label class="a-field <%= err('durationMin') %>"><span>Duration</span>
          <select name="durationMin">
            <% const durations = [15, 20, 30, 40, 45, 60, 75, 90, 105, 120, 150, 180, 240]; if (v.durationMin && !durations.includes(Number(v.durationMin))) durations.push(Number(v.durationMin)); durations.sort((a, b) => a - b); %>
            <% durations.forEach((d) => { %><option value="<%= d %>" <%= Number(v.durationMin) === d ? 'selected' : '' %>><%= duration(d) %></option><% }) %>
          </select>
          <% if (e.durationMin) { %><p class="field-error"><%= e.durationMin %></p><% } %>
        </label>
        <label class="a-field sm:col-span-2 <%= err('description') %>"><span>Description <em class="not-italic normal-case tracking-normal text-ink/50">(optional)</em></span>
          <textarea name="description" rows="3" maxlength="400" placeholder="One or two sentences shown on the services card."><%= v.description || '' %></textarea>
          <% if (e.description) { %><p class="field-error"><%= e.description %></p><% } %>
        </label>
      </div>
    </section>

    <section class="a-card">
      <h2 class="a-h3">Who offers it</h2>
      <p class="mt-1 text-sm text-ink/65">Only these barbers can be booked for this service.</p>
      <div class="a-checks mt-4">
        <% barbers.forEach((b) => { %>
          <label class="a-check <%= b.active ? '' : 'is-muted' %>">
            <input type="checkbox" name="barberIds" value="<%= b.id %>" class="sr-only" <%= (v.barberIds || []).includes(b.id) ? 'checked' : '' %> />
            <% if (imageOf(b, 'photo')) { %><img src="<%= imageUrl(imageOf(b, 'photo'), { w: 64, h: 64 }) %>" <%- imgSize(imageOf(b, 'photo'), { w: 64, h: 64 }) %> alt="" class="h-8 w-8 rounded-full object-cover object-top" loading="lazy" /><% } else { %><span class="grid h-8 w-8 place-items-center rounded-full bg-paper-deep font-serif"><%= b.name[0] %></span><% } %>
            <span><%= b.name %><% if (!b.active) { %> <span class="text-xs text-ink/55">(inactive)</span><% } %></span>
            <span class="choice-check ml-auto shrink-0" aria-hidden="true"></span>
          </label>
        <% }) %>
      </div>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="a-card">
      <%- include('../partials/image-input', { current: imageOf(service), width: 600, label: 'Card photo', error: e.image, shape: 'portrait' }) %>
    </section>
    <section class="a-card space-y-5">
      <%- include('../partials/switch', { name: 'active', checked: v.active, label: 'Live on the site', hint: 'Hidden services can’t be booked.' }) %>
      <%- include('../partials/switch', { name: 'homeAvailable', checked: v.homeAvailable, label: 'Available for home visits', hint: 'Off means shop only.' }) %>
    </section>
    <div class="xl:sticky xl:top-6">
      <button type="submit" class="btn-primary w-full justify-center" data-a-submit><%= service ? 'Save changes' : 'Add service' %> <span class="arrow" aria-hidden="true">→</span></button>
      <a href="/admin/services" class="mt-3 block text-center text-sm text-ink/65 hover:text-ink">Cancel</a>
    </div>
  </aside>
</form>
