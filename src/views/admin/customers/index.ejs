<% const sorts = [['recent', 'Last visit'], ['visits', 'Most visits'], ['spent', 'Top spend'], ['noshows', 'No-shows'], ['name', 'Name A–Z'], ['newest', 'Newest']]; %>
<% const qs = (over) => Object.entries({ q, sort, ...over }).filter(([, v]) => v !== '' && v !== undefined && v !== null).map(([k, v]) => `${k}=${encodeURIComponent(v)}`).join('&'); %>
<header class="a-page-head">
  <div>
    <p class="eyebrow">Customers</p>
    <h1 class="a-title"><%= total %> <em class="accent"><%= total === 1 ? 'customer' : 'customers' %></em></h1>
    <p class="mt-2 text-ink/65"><%= q ? `Matching “${q}”.` : 'Everyone who has booked, online or with staff.' %></p>
  </div>
</header>

<form method="get" action="/admin/customers" class="a-filters a-filters-simple">
  <label class="a-search col-span-2">
    <%- include('../partials/icon', { name: 'search' }) %>
    <span class="sr-only">Search customers</span>
    <input type="search" name="q" value="<%= q %>" placeholder="Name, phone or email" autocomplete="off" />
  </label>
  <label class="a-field"><span>Sort by</span>
    <select name="sort" data-auto-submit>
      <% sorts.forEach(([k, label]) => { %><option value="<%= k %>" <%= sort === k ? 'selected' : '' %>><%= label %></option><% }) %>
    </select>
  </label>
  <div class="flex items-end gap-2">
    <button type="submit" class="btn-primary flex-1 justify-center">Search</button>
    <% if (q) { %><a href="/admin/customers?sort=<%= sort %>" class="btn-ghost">Clear</a><% } %>
  </div>
</form>

<section class="mt-6" aria-label="Customers">
  <% if (!rows.length) { %>
    <div class="a-empty">
      <p class="font-serif text-3xl"><%= q ? 'No one matches that.' : 'No customers yet.' %></p>
      <p class="mt-2 text-ink/65"><%= q ? 'Try part of the phone number, e.g. 803 123.' : 'They appear here after their first booking.' %></p>
    </div>
  <% } else { %>
    <div class="a-table-wrap">
      <table class="a-table">
        <thead>
          <tr><th>Customer</th><th>Phone</th><th>Visits</th><th>Spent</th><th>Last visit</th><th><span class="sr-only">Open</span></th></tr>
        </thead>
        <tbody>
          <% rows.forEach((c) => { %>
            <tr data-href="/admin/customers/<%= c.id %>">
              <td data-label="Customer">
                <span class="flex items-center gap-3">
                  <span class="a-avatar" aria-hidden="true"><%= c.name.trim()[0] %></span>
                  <span class="min-w-0">
                    <a href="/admin/customers/<%= c.id %>" class="block truncate font-medium hover:underline"><%= c.name %></a>
                    <span class="block truncate text-xs text-ink/65"><%= c.email || 'No email' %></span>
                  </span>
                </span>
              </td>
              <td data-label="Phone" class="tabular-nums"><%= fmtPhone(c.phone) %></td>
              <td data-label="Visits">
                <span class="tabular-nums font-medium"><%= c.visits %></span>
                <% if (c.noShowCount) { %><span class="a-type a-type-warn ml-1"><%= c.noShowCount %> no-show<%= c.noShowCount > 1 ? 's' : '' %></span><% } %>
              </td>
              <td data-label="Spent" class="tabular-nums"><%= naira(c.spent) %></td>
              <td data-label="Last visit"><%= c.lastAt ? formatShort(c.lastAt) : '—' %></td>
              <td class="a-table-go"><a href="/admin/customers/<%= c.id %>" aria-label="Open <%= c.name %>"><%- include('../partials/icon', { name: 'chevron' }) %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (pages > 1) { %>
      <nav class="mt-6 flex items-center justify-between gap-4" aria-label="Pages">
        <% if (page > 1) { %><a class="btn-ghost" href="/admin/customers?<%= qs({ page: page - 1 }) %>">← Previous</a><% } else { %><span></span><% } %>
        <span class="text-sm text-ink/65">Page <%= page %> of <%= pages %></span>
        <% if (page < pages) { %><a class="btn-ghost" href="/admin/customers?<%= qs({ page: page + 1 }) %>">Next →</a><% } else { %><span></span><% } %>
      </nav>
    <% } %>
  <% } %>
</section>
