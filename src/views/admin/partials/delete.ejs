<%# Delete button + confirm dialog. Params: id, action, title, body, label (button text) %>
<button type="button" class="a-danger-link" data-dialog-open="del-<%= id %>"><%= locals.label || 'Delete' %></button>
<dialog id="del-<%= id %>" class="b-dialog" aria-labelledby="del-title-<%= id %>">
  <form method="post" action="<%= action %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <p class="eyebrow">Delete</p>
    <h2 id="del-title-<%= id %>" class="mt-4 text-3xl"><%= title %></h2>
    <p class="mt-3 text-ink/70"><%= body %></p>
    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
      <button type="button" class="btn-ghost" data-dialog-close>Keep it</button>
      <button type="submit" class="btn-primary">Yes, delete</button>
    </div>
  </form>
</dialog>
