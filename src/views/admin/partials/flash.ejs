<% if (locals.flash) { %>
  <div class="flash flash-<%= flash.type %> a-flash" role="<%= flash.type === 'error' ? 'alert' : 'status' %>" data-a-flash>
    <span class="flash-icon" aria-hidden="true"><%= flash.type === 'error' ? '!' : '✓' %></span>
    <p class="flex-1"><%= flash.message %></p>
    <button type="button" class="text-lg leading-none text-ink/50 hover:text-ink" data-a-flash-close aria-label="Dismiss">×</button>
  </div>
<% } %>
