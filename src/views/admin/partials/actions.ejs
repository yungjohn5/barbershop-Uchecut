<%#
  Status action buttons for a booking. Params: booking, actions (array), size ('sm' | 'md')
  Cancel opens a dialog (reason). Without JS the dialog's form is still reachable via the detail page.
%>
<% const sm = (locals.size || 'sm') === 'sm'; const cls = sm ? '!min-h-[2.4rem] !px-4 !py-2 text-sm' : ''; %>
<% const post = (action, label, style) => { %>
  <form method="post" action="/admin/bookings/<%= booking.id %>/status" class="inline">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="action" value="<%= action %>" />
    <button type="submit" class="<%= style %> <%= cls %>"><%= label %></button>
  </form>
<% } %>
<div class="flex flex-wrap items-center gap-2">
  <% if (actions.includes('confirm')) post('confirm', 'Confirm', 'btn-primary'); %>
  <% if (actions.includes('complete')) post('complete', 'Complete', 'btn-primary'); %>
  <% if (actions.includes('noShow')) post('noShow', 'No-show', 'btn-ghost'); %>
  <% if (actions.includes('undo')) post('undo', 'Undo', 'btn-ghost'); %>
  <% if (actions.includes('reschedule') && !sm) { %>
    <a href="/admin/bookings/<%= booking.id %>/reschedule" class="btn-ghost <%= cls %>">Reschedule</a>
  <% } %>
  <% if (actions.includes('cancel')) { %>
    <button type="button" class="btn-ghost <%= cls %>" data-dialog-open="cancel-<%= booking.id %>">Cancel</button>
    <dialog id="cancel-<%= booking.id %>" class="b-dialog" aria-labelledby="cancel-title-<%= booking.id %>">
      <form method="post" action="/admin/bookings/<%= booking.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="action" value="cancel" />
        <p class="eyebrow">Cancel booking</p>
        <h2 id="cancel-title-<%= booking.id %>" class="mt-4 text-3xl">Cancel <%= booking.reference %>?</h2>
        <p class="mt-3 text-ink/70"><%= booking.customer.name %>’s slot will be released, and they’ll get an SMS and email saying it was cancelled (with your reason, if you add one).</p>
        <div class="field-float mt-6">
          <textarea id="reason-<%= booking.id %>" name="reason" rows="2" placeholder=" " maxlength="300"></textarea>
          <label for="reason-<%= booking.id %>">Reason <span class="font-normal opacity-70">(optional)</span></label>
        </div>
        <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
          <button type="button" class="btn-ghost" data-dialog-close>Keep booking</button>
          <button type="submit" class="btn-primary">Yes, cancel</button>
        </div>
      </form>
    </dialog>
  <% } %>
</div>
