<section class="grid min-h-[100svh] lg:grid-cols-[1.1fr_1fr]">
  <div class="keep-dark relative hidden overflow-hidden bg-ink text-paper grain lg:block">
    <img src="<%= imageUrl(siteImg('hero'), { w: 1400 }) %>" <%- imgSize(siteImg('hero'), { w: 1400 }) %> alt="" class="absolute inset-0 h-full w-full object-cover opacity-55" />
    <div class="absolute inset-0 bg-gradient-to-t from-night via-night/40 to-night/20" aria-hidden="true"></div>
    <div class="relative flex h-full flex-col justify-between p-12">
      <a href="/" class="font-serif text-3xl"><%= shop.name.split(' ')[0] %></a>
      <div>
        <p class="eyebrow !text-paper/60">Back office</p>
        <p class="mt-4 max-w-md font-serif text-5xl leading-[1.05]">Every chair, every visit, <em class="accent">in one place</em>.</p>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-center px-5 py-16 sm:px-10">
    <div class="w-full max-w-sm">
      <a href="/" class="font-serif text-3xl lg:hidden"><%= shop.name.split(' ')[0] %></a>
      <p class="eyebrow mt-10 lg:mt-0">Admin</p>
      <h1 class="mt-4 text-4xl leading-tight">Sign in</h1>
      <p class="mt-3 text-ink/65">For shop staff only.</p>

      <% if (error) { %>
        <div class="flash flash-error mt-8 !mb-0" role="alert"><span class="flash-icon" aria-hidden="true">!</span><p><%= error %></p></div>
      <% } %>

      <%# next= is in the URL too, so a reload after a failed attempt keeps it. %>
      <form method="post" action="/admin/login<%= next && next !== '/admin' ? `?next=${encodeURIComponent(next)}` : '' %>" class="mt-8 grid gap-4" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="next" value="<%= next %>" />
        <div class="field-float">
          <input id="a-email" name="email" type="email" autocomplete="username" placeholder=" " required value="<%= email %>" autofocus />
          <label for="a-email">Email</label>
        </div>
        <div class="field-float">
          <input id="a-password" name="password" type="password" autocomplete="current-password" placeholder=" " required />
          <label for="a-password">Password</label>
        </div>
        <button type="submit" class="btn-primary mt-2 w-full justify-center">Sign in <span class="arrow" aria-hidden="true">→</span></button>
      </form>
      <p class="mt-8 text-sm text-ink/65">Locked out after 5 wrong attempts for 15 minutes. Ask the owner to reset your password.</p>
      <p class="mt-6 text-sm"><a href="/" class="link-u text-ink/65 hover:text-ink">← Back to home</a></p>
    </div>
  </div>
</section>
