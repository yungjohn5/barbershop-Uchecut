<% const v = values; const e = errors || {}; const err = (k) => (e[k] ? 'has-error' : ''); %>
<nav class="text-sm text-ink/65" aria-label="Breadcrumb"><a href="/admin/products" class="link-u">Products</a> <span aria-hidden="true">/</span> <%= product ? product.name : 'New' %></nav>
<header class="a-page-head">
  <div>
    <p class="eyebrow"><%= product ? 'Edit product' : 'New product' %></p>
    <h1 class="a-title"><% if (product) { %><%= product.name %><% } else { %>Add a <em class="accent">product</em><% } %></h1>
  </div>
  <% if (product) { %>
    <%- include('../partials/delete', { id: `prod-${product.id}`, action: `/admin/products/${product.id}/delete`, title: `Delete ${product.name}?`, body: 'It will be removed from the home page and its photo deleted.', label: 'Delete product' }) %>
  <% } %>
</header>

<form method="post" action="/admin/products<%= product ? `/${product.id}` : '' %>" enctype="multipart/form-data" class="grid grid-cols-1 gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]" data-a-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <section class="a-card">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="a-field <%= err('name') %>"><span>Name</span>
        <input name="name" value="<%= v.name || '' %>" maxlength="60" required placeholder="e.g. Matte Clay" />
        <% if (e.name) { %><p class="field-error"><%= e.name %></p><% } %>
      </label>
      <label class="a-field <%= err('price') %>"><span>Price <em class="not-italic normal-case tracking-normal text-ink/50">(optional)</em></span>
        <span class="a-money"><span aria-hidden="true">₦</span><input name="price" inputmode="decimal" value="<%= v.price || '' %>" placeholder="Leave blank to hide" /></span>
        <% if (e.price) { %><p class="field-error"><%= e.price %></p><% } %>
      </label>
      <label class="a-field sm:col-span-2 <%= err('description') %>"><span>Description <em class="not-italic normal-case tracking-normal text-ink/50">(optional)</em></span>
        <textarea name="description" rows="3" maxlength="400"><%= v.description || '' %></textarea>
        <% if (e.description) { %><p class="field-error"><%= e.description %></p><% } %>
      </label>
    </div>
    <div class="mt-6"><%- include('../partials/switch', { name: 'visible', checked: v.visible, label: 'Show on the home page' }) %></div>
  </section>
  <aside class="space-y-6">
    <section class="a-card"><%- include('../partials/image-input', { current: imageOf(product), width: 600, label: 'Product photo', hint: 'Square works best. JPG, PNG or WebP up to 8 MB.', error: e.image }) %></section>
    <div>
      <button type="submit" class="btn-primary w-full justify-center" data-a-submit><%= product ? 'Save changes' : 'Add product' %> <span class="arrow" aria-hidden="true">→</span></button>
      <a href="/admin/products" class="mt-3 block text-center text-sm text-ink/65 hover:text-ink">Cancel</a>
    </div>
  </aside>
</form>
