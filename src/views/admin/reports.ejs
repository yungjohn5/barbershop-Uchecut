<%
  const r = report;
  const pctText = (x) => (x === null || x === undefined ? '—' : `${Math.round(x * 100)}%`);
  const delta = (x) => {
    if (x === null || x === undefined) return '<span class="a-delta">no earlier data</span>';
    const n = Math.round(x * 100);
    const cls = n > 0 ? 'is-up' : n < 0 ? 'is-down' : '';
    return `<span class="a-delta ${cls}">${n > 0 ? '▲' : n < 0 ? '▼' : '•'} ${Math.abs(n)}% vs previous</span>`;
  };
  const maxDay = Math.max(1, ...r.days.map((d) => d.bookedKobo));
  const n = r.days.length;
  const step = 100 / n;
  const ticks = n <= 7 ? r.days.map((d, i) => i) : [0, Math.floor((n - 1) / 2), n - 1];
  const maxWeekday = Math.max(1, ...r.weekdays.map((w) => w.count));
  const WD = { 0: 'Sun', 1: 'Mon', 2: 'Tue', 3: 'Wed', 4: 'Thu', 5: 'Fri', 6: 'Sat' };
  const bar = (value, max) => `<svg class="a-bar" viewBox="0 0 100 8" preserveAspectRatio="none" aria-hidden="true"><rect class="a-bar-track" width="100" height="8" rx="4"/><rect class="a-bar-fill" width="${max ? Math.max(1.5, (value / max) * 100) : 0}" height="8" rx="4"/></svg>`;
%>
<header class="a-page-head">
  <div>
    <p class="eyebrow">Reports</p>
    <h1 class="a-title"><%= range.label %></h1>
    <p class="mt-2 text-ink/65"><%= formatShortDate(range.from) %> – <%= formatShortDate(range.to) %>, compared with <%= formatShortDate(prev.from) %> – <%= formatShortDate(prev.to) %>.</p>
  </div>
</header>

<%# The custom-range popover sits outside the scrolling chip row so it isn't clipped. %>
<div class="flex items-center gap-2">
<nav class="no-scrollbar -ml-4 flex min-w-0 flex-1 gap-2 overflow-x-auto pl-4 sm:ml-0 sm:pl-0" aria-label="Period">
  <% Object.entries(presets).forEach(([key, label]) => { %>
    <a href="/admin/reports?preset=<%= key %>" class="a-chip <%= range.preset === key ? 'is-active' : '' %>" <%- range.preset === key ? 'aria-current="page"' : '' %>><%= label %></a>
  <% }) %>
</nav>
  <details class="a-pop shrink-0">
    <summary class="a-chip <%= range.preset === 'custom' ? 'is-active' : '' %>">Custom…</summary>
    <form method="get" action="/admin/reports" class="a-pop-panel grid gap-3">
      <label class="a-field"><span>From</span><input type="date" name="from" value="<%= range.from %>" required /></label>
      <label class="a-field"><span>To</span><input type="date" name="to" value="<%= range.to %>" required /></label>
      <button type="submit" class="btn-primary justify-center">Show</button>
    </form>
  </details>
</div>

<section class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 xl:grid-cols-4" aria-label="Headline numbers">
  <div class="a-stat">
    <p class="a-stat-label">Booked revenue</p>
    <p class="a-stat-value text-[clamp(1.5rem,3vw,2.4rem)]"><%= naira(r.bookedKobo) %></p>
    <p class="a-stat-foot"><%- delta(deltas.bookedKobo) %></p>
  </div>
  <div class="a-stat">
    <p class="a-stat-label">Taken (completed)</p>
    <p class="a-stat-value text-[clamp(1.5rem,3vw,2.4rem)]"><%= naira(r.takenKobo) %></p>
    <p class="a-stat-foot"><%- delta(deltas.takenKobo) %></p>
  </div>
  <div class="a-stat">
    <p class="a-stat-label">Bookings</p>
    <p class="a-stat-value"><%= r.standing %></p>
    <p class="a-stat-foot"><%- delta(deltas.standing) %></p>
  </div>
  <div class="a-stat">
    <p class="a-stat-label">Average ticket</p>
    <p class="a-stat-value text-[clamp(1.5rem,3vw,2.4rem)]"><%= naira(r.avgTicketKobo) %></p>
    <p class="a-stat-foot"><%- delta(deltas.avgTicketKobo) %></p>
  </div>
</section>

<section class="a-card mt-6" aria-labelledby="daily-h">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <h2 id="daily-h" class="a-h3">Revenue by day</h2>
    <div class="flex gap-4 text-xs text-ink/65" aria-hidden="true">
      <span class="flex items-center gap-1.5"><i class="a-key a-key-taken"></i>Taken</span>
      <span class="flex items-center gap-1.5"><i class="a-key a-key-booked"></i>Booked, not yet completed</span>
    </div>
  </div>
  <% if (!r.standing) { %>
    <p class="a-empty-row mt-5">No bookings in this period.</p>
  <% } else { %>
    <div class="a-chart mt-5">
      <svg viewBox="0 0 100 50" preserveAspectRatio="none" role="img" aria-label="Revenue by day, highest <%= naira(maxDay) %>">
        <% [0.25, 0.5, 0.75].forEach((g) => { %><line class="a-chart-grid" x1="0" x2="100" y1="<%= 50 - g * 48 %>" y2="<%= 50 - g * 48 %>" /><% }) %>
        <% r.days.forEach((d, i) => { const hB = (d.bookedKobo / maxDay) * 48; const hT = (d.takenKobo / maxDay) * 48; const w = step * 0.72; const x = i * step + (step - w) / 2; %>
          <g>
            <title><%= formatShortDate(d.date) %>: <%= naira(d.bookedKobo) %> booked, <%= naira(d.takenKobo) %> taken, <%= d.count %> booking<%= d.count === 1 ? '' : 's' %></title>
            <rect class="a-chart-hit" x="<%= i * step %>" y="0" width="<%= step %>" height="50" />
            <% if (hB) { %><rect class="a-chart-booked" x="<%= x %>" y="<%= 50 - hB %>" width="<%= w %>" height="<%= hB %>" rx="0.6" /><% } %>
            <% if (hT) { %><rect class="a-chart-taken" x="<%= x %>" y="<%= 50 - hT %>" width="<%= w %>" height="<%= hT %>" rx="0.6" /><% } %>
          </g>
        <% }) %>
      </svg>
      <span class="a-chart-max"><%= naira(maxDay) %></span>
    </div>
    <div class="a-chart-ticks" aria-hidden="true">
      <% ticks.forEach((i) => { %><span class="<%= n <= 7 ? 'is-even' : '' %>"><%= n <= 7 ? WD[new Date(`${r.days[i].date}T12:00:00Z`).getUTCDay()] : formatShortDate(r.days[i].date) %></span><% }) %>
    </div>
  <% } %>
</section>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <section class="a-card" aria-labelledby="barber-h">
    <h2 id="barber-h" class="a-h3">By barber</h2>
    <% if (!r.byBarber.length) { %><p class="a-empty-row mt-4">Nothing yet.</p><% } %>
    <ul class="mt-4 space-y-4">
      <% const maxB = Math.max(1, ...r.byBarber.map((b) => b.bookedKobo)); r.byBarber.forEach((b) => { %>
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm">
            <span class="truncate font-medium"><%= b.name %></span>
            <span class="shrink-0 tabular-nums"><%= naira(b.bookedKobo) %> <span class="text-ink/55">· <%= b.count %></span></span>
          </div>
          <%- bar(b.bookedKobo, maxB) %>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="a-card" aria-labelledby="mix-h">
    <h2 id="mix-h" class="a-h3">How bookings went</h2>
    <dl class="a-mix mt-4">
      <div><dt>Completed</dt><dd><%= r.status.COMPLETED %></dd></div>
      <div><dt>Still to come</dt><dd><%= r.status.PENDING + r.status.CONFIRMED %></dd></div>
      <div><dt>Cancelled</dt><dd><%= r.status.CANCELLED %> <small><%= pctText(r.cancelRate) %></small></dd></div>
      <div><dt>No-shows</dt><dd><%= r.status.NO_SHOW %> <small><%= pctText(r.noShowRate) %></small></dd></div>
      <div><dt>Home visits</dt><dd><%= pctText(r.homeShare) %></dd></div>
      <div><dt>Booked by staff</dt><dd><%= pctText(r.staffShare) %></dd></div>
    </dl>
    <p class="mt-4 text-xs text-ink/60">No-show rate is out of visits that were due (completed + no-shows).</p>
  </section>

  <section class="a-card" aria-labelledby="svc-h">
    <h2 id="svc-h" class="a-h3">Top services</h2>
    <% if (!r.byService.length) { %><p class="a-empty-row mt-4">Nothing yet.</p><% } %>
    <ul class="mt-4 space-y-4">
      <% const maxS = Math.max(1, ...r.byService.map((s) => s.revenueKobo)); r.byService.slice(0, 8).forEach((s) => { %>
        <li>
          <div class="flex items-baseline justify-between gap-3 text-sm">
            <span class="truncate font-medium"><%= s.name %></span>
            <span class="shrink-0 tabular-nums"><%= naira(s.revenueKobo) %> <span class="text-ink/55">· <%= s.count %>×</span></span>
          </div>
          <%- bar(s.revenueKobo, maxS) %>
        </li>
      <% }) %>
    </ul>
  </section>

  <section class="a-card" aria-labelledby="wd-h">
    <h2 id="wd-h" class="a-h3">Busiest days</h2>
    <div class="a-weekbars mt-5" role="img" aria-label="Bookings per weekday: <%= r.weekdays.map((w) => `${WD[w.weekday]} ${w.count}`).join(', ') %>">
      <% r.weekdays.forEach((w) => { %>
        <div class="a-weekbar">
          <span class="text-xs tabular-nums text-ink/65"><%= w.count %></span>
          <svg viewBox="0 0 10 60" preserveAspectRatio="none" aria-hidden="true"><rect class="a-bar-track" x="0" y="0" width="10" height="60" rx="3" /><% if (w.count) { %><rect class="a-bar-fill" x="0" y="<%= 60 - (w.count / maxWeekday) * 60 %>" width="10" height="<%= (w.count / maxWeekday) * 60 %>" rx="3" /><% } %></svg>
          <span class="text-xs font-medium"><%= WD[w.weekday] %></span>
        </div>
      <% }) %>
    </div>
    <% if (r.byZone.length) { %>
      <h3 class="mt-8 font-sans text-xs font-medium uppercase tracking-[0.16em] text-ink/65">Home visits by zone</h3>
      <ul class="mt-3 divide-y divide-ink/10 text-sm">
        <% r.byZone.forEach((z) => { %>
          <li class="flex items-center justify-between gap-3 py-2.5"><span class="truncate"><%= z.name %></span><span class="tabular-nums text-ink/70"><%= z.count %> · <%= naira(z.feesKobo) %> fees</span></li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
