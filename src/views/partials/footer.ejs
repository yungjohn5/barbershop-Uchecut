<footer id="visit" class="relative overflow-hidden bg-ink text-paper grain">
  <div class="relative mx-auto max-w-[88rem] px-5 pb-28 pt-20 sm:px-8 md:pb-10 lg:px-10 lg:pt-28">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <p class="eyebrow !text-paper/50"><span class="eyebrow-num">07</span>Visit &amp; book</p>
      <% if (locals.status) { %>
        <p class="inline-flex items-center gap-2.5 rounded-full border border-paper/15 px-4 py-2 text-sm text-paper/80">
          <span class="status-dot <%= status.open ? 'is-open' : '' %>" aria-hidden="true"></span><%= status.label %>
        </p>
      <% } %>
    </div>

    <div class="mt-6 overflow-hidden">
      <h2 class="clip-text bg-chair inline-block whitespace-nowrap font-sans text-[9.4vw] font-black uppercase leading-[0.84] tracking-[-0.045em]" data-chair data-fit>Take the Chair</h2>
    </div>

    <div class="mt-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      <div class="sm:col-span-2 lg:col-span-5" data-reveal>
        <p class="max-w-sm text-lg leading-snug text-paper/85"><%= (locals.copy && copy.footerText) || 'Book your session. Step into a room where time slows down and details matter.' %></p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/book?type=SHOP" class="btn-primary">Book in shop <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/book?type=HOME" class="btn-ghost-light">Book a home visit</a>
        </div>
        <a href="https://wa.me/<%= shop.whatsapp %>" rel="noopener" class="mt-6 inline-flex items-center gap-2 text-sm text-paper/70 underline-offset-4 hover:text-paper hover:underline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
          Message us on WhatsApp
        </a>
      </div>

      <div class="lg:col-span-3 lg:col-start-7" data-reveal>
        <p class="eyebrow !text-paper/50">Hours</p>
        <ul class="mt-4 space-y-1.5 text-[0.98rem]">
          <% shop.hoursText.forEach((line) => { %><li><%= line %></li><% }) %>
        </ul>
      </div>

      <div class="lg:col-span-3" data-reveal>
        <p class="eyebrow !text-paper/50">Find us</p>
        <address class="mt-4 space-y-1.5 text-[0.98rem] not-italic">
          <% shop.address.forEach((line) => { %><span class="block"><%= line %></span><% }) %>
          <a href="tel:<%= shop.phone %>" class="block pt-3 hover:text-amber-light"><%= shop.phone %></a>
          <a href="mailto:<%= shop.email %>" class="block hover:text-amber-light"><%= shop.email %></a>
        </address>
      </div>
    </div>

    <div class="mt-20 flex flex-col gap-4 border-t border-paper/10 pt-6 text-sm text-paper/50 sm:flex-row sm:items-center sm:justify-between">
      <p>© <%= new Date().getFullYear() %> <%= shop.name %> · Lagos, Nigeria</p>
      <div class="flex items-center gap-5">
        <% Object.entries(shop.socials || {}).filter(([, url]) => url).forEach(([name, url]) => { %>
          <a href="<%= url %>" rel="noopener" class="capitalize hover:text-paper"><%= name === 'x' ? 'X' : name %></a>
        <% }) %>
        <a href="#main" class="hover:text-paper">Back to top ↑</a>
      </div>
    </div>
  </div>
</footer>
