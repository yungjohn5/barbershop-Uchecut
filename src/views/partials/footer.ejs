<footer id="visit" class="mt-24 bg-ink text-paper">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="font-serif text-[clamp(3rem,12vw,9rem)] uppercase leading-none">Take the Chair</p>
    <div class="mt-12 grid gap-8 text-base sm:grid-cols-3">
      <div>
        <p class="eyebrow text-paper/60">Hours</p>
        <% shop.hoursText.forEach((line) => { %><p><%= line %></p><% }) %>
      </div>
      <div>
        <p class="eyebrow text-paper/60">Address</p>
        <% shop.address.forEach((line) => { %><p><%= line %></p><% }) %>
      </div>
      <div>
        <p class="eyebrow text-paper/60">Contact</p>
        <p><a class="underline-offset-4 hover:underline" href="tel:<%= shop.phone %>"><%= shop.phone %></a></p>
        <p><a class="underline-offset-4 hover:underline" href="https://wa.me/<%= shop.whatsapp %>" rel="noopener">WhatsApp us</a></p>
      </div>
    </div>
    <p class="mt-16 text-sm text-paper/50">© <%= new Date().getFullYear() %> <%= shop.name %>. Lagos, Nigeria.</p>
  </div>
</footer>
