<div id="mobile-menu" class="keep-dark fixed inset-0 z-50 flex flex-col overflow-y-auto bg-ink text-paper grain" role="dialog" aria-modal="true" aria-label="Menu" hidden data-menu>
  <div class="relative flex items-center justify-between px-5 py-5 sm:px-8">
    <a href="/" class="font-serif text-[1.75rem] leading-none"><%= shop.name.split(' ')[0] %></a>
    <button type="button" class="icon-btn-light" data-menu-close>
      <span class="sr-only">Close menu</span>
      <svg class="close-x" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.6"/></svg>
    </button>
  </div>
  <nav aria-label="Mobile" class="relative flex-1 px-5 pt-6 sm:px-8">
    <ul class="space-y-1">
      <% const menuLinks = [['About', '/#intro'], ['Services', '/#services'], ['Barbers', '/#barbers'], ['Home visits', '/#home-service'], ['Products', '/#products'], ['Visit us', '/#visit']];
         if (locals.gallery && gallery.length) menuLinks.splice(3, 0, ['Lookbook', '/#lookbook']); %>
      <% menuLinks.forEach(([label, href], i) => { %>
        <li class="overflow-hidden">
          <a href="<%= href %>" class="menu-link flex items-baseline gap-4 py-1 font-serif text-[2.6rem] leading-tight" data-menu-link>
            <span class="font-sans text-xs tabular-nums text-paper/40"><%= pad2(i + 1) %></span><%= label %>
          </a>
        </li>
      <% }) %>
    </ul>
  </nav>
  <div class="relative grid gap-3 px-5 pb-[max(1.5rem,env(safe-area-inset-bottom))] pt-10 sm:px-8" data-menu-link>
    <a href="/book?type=SHOP" class="btn-primary w-full">Book in shop</a>
    <% if (locals.homeOpen !== false) { %><a href="/book?type=HOME" class="btn-ghost-light w-full">Book a home visit</a><% } %>
    <div class="mt-3 flex items-center justify-between gap-4 border-t border-paper/10 pt-4">
      <p class="text-sm text-paper/50"><%= shop.hoursText.join(' · ') %></p>
      <%- include('theme-toggle', { tone: 'light', id: 'menu' }) %>
    </div>
  </div>
</div>
