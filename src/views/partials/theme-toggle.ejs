<%#
  Light/dark switch: a sun that morphs into a moon. Behaviour in public/js/site.js.
  Params: tone ('light' on dark backgrounds | 'dark' on paper), id (unique per page)
%>
<button
  type="button"
  class="theme-toggle <%= tone === 'light' ? 'icon-btn-light' : 'icon-btn-dark' %>"
  role="switch"
  aria-checked="false"
  aria-label="Dark mode"
  title="Toggle dark mode"
  data-theme-toggle
>
  <svg class="theme-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <mask id="theme-mask-<%= id %>">
      <rect width="24" height="24" fill="white" />
      <circle class="theme-cut" cx="25" cy="9" r="6" fill="black" />
    </mask>
    <circle class="theme-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-mask-<%= id %>)" />
    <g class="theme-rays" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
      <line x1="12" y1="1.75" x2="12" y2="3.75" />
      <line x1="12" y1="20.25" x2="12" y2="22.25" />
      <line x1="1.75" y1="12" x2="3.75" y2="12" />
      <line x1="20.25" y1="12" x2="22.25" y2="12" />
      <line x1="4.75" y1="4.75" x2="6.15" y2="6.15" />
      <line x1="17.85" y1="17.85" x2="19.25" y2="19.25" />
      <line x1="4.75" y1="19.25" x2="6.15" y2="17.85" />
      <line x1="17.85" y1="6.15" x2="19.25" y2="4.75" />
    </g>
  </svg>
</button>
