<%#
  Main navigation. variant: 'light' (inside the dark hero card) | 'dark' (on paper).
%>
<% const light = variant === 'light'; %>
<% const links = [['About', '/#intro'], ['Services', '/#services'], ['Barbers', '/#barbers'], ['Home visits', '/#home-service'], ['Products', '/#products']]; %>
<header class="relative z-20 <%= light ? 'text-paper' : 'text-ink' %>">
  <div class="relative flex items-center justify-between gap-4 px-5 py-4 sm:px-8 sm:py-5 lg:px-12 <%= light ? '' : 'mx-auto max-w-[88rem] lg:!px-10' %>" <%= light ? 'data-hero-nav' : '' %>>
    <nav aria-label="Main" class="hidden items-center gap-7 text-[0.92rem] xl:flex">
      <% links.forEach(([label, href]) => { %>
        <a href="<%= href %>" class="opacity-80 transition-opacity hover:opacity-100"><%= label %></a>
      <% }) %>
    </nav>
    <a href="/" class="font-serif text-[1.75rem] leading-none xl:absolute xl:left-1/2 xl:-translate-x-1/2" aria-label="<%= shop.name %> home"><%= shop.name.split(' ')[0] %></a>
    <div class="flex items-center gap-3">
      <a href="/#visit" class="hidden text-[0.92rem] opacity-80 transition-opacity hover:opacity-100 xl:inline">Visit Us</a>
      <a href="/book" class="<%= light ? 'btn-light' : 'btn-primary' %> hidden !px-5 !py-2.5 text-sm sm:inline-flex">Book Now</a>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full border <%= light ? 'border-paper/30' : 'border-ink/20' %> xl:hidden" aria-controls="mobile-menu" aria-expanded="false" data-menu-open>
        <span class="sr-only">Open menu</span>
        <svg width="18" height="10" viewBox="0 0 18 10" fill="none" aria-hidden="true"><path d="M0 1h18M6 9h12" stroke="currentColor" stroke-width="1.6"/></svg>
      </button>
    </div>
  </div>
</header>
