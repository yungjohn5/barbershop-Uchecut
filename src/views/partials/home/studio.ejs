<%#
  Ad for the studio that built the site (content in src/config/credits.js).
  Clearly labelled as an ad and kept outside the numbered shop sections.
%>
<% const c = credits; const icons = {
  code: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>',
  cart: '<path d="M3 4h2l2.4 10.4a1.5 1.5 0 0 0 1.5 1.1h8.6a1.5 1.5 0 0 0 1.4-1l2-6.5H6.2"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/>',
  cap: '<path d="M2.5 9.5L12 5l9.5 4.5L12 14 2.5 9.5z"/><path d="M6.5 11.5V16c1.6 1.6 3.6 2.4 5.5 2.4s3.9-.8 5.5-2.4v-4.5M21.5 9.5V15"/>',
  truck: '<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.7"/><circle cx="17" cy="17.5" r="1.7"/>',
  compass: '<circle cx="12" cy="12" r="8.5"/><path d="M15.5 8.5l-2 5-5 2 2-5 5-2z"/>',
  board: '<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M9.5 4.5v15M15 4.5v15M5.5 8.5h2M11.5 8.5h1.5M11.5 11.5h1.5M17 8.5h1.5"/>',
}; %>
<section id="built-by" class="relative bg-paper px-4 pb-20 pt-6 sm:px-8 lg:px-10 lg:pb-28" aria-labelledby="studio-title">
  <div class="studio keep-dark grain mx-auto max-w-[88rem]" data-reveal>
    <div class="studio-glow" aria-hidden="true"></div>
    <div class="relative grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <p class="studio-badge"><span>Ad</span> The studio behind this site</p>
        <p class="mt-8 font-serif text-2xl text-paper/90"><%= c.name %></p>
        <h2 id="studio-title" class="mt-3 text-[clamp(2.1rem,4.2vw,3.6rem)] leading-[1.02] text-paper">Want a site like this for <em class="accent">your</em> business?</h2>
        <p class="mt-6 max-w-xl text-[1.02rem] leading-relaxed text-paper/70"><%= c.pitch %></p>
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Why work with us">
          <% c.points.forEach((p) => { %><li class="studio-chip"><%= p %></li><% }) %>
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="<%= c.url %>" target="_blank" rel="noopener" class="btn-primary">Visit Cyberninja Innovations <span class="arrow" aria-hidden="true">→</span></a>
          <a href="https://wa.me/<%= c.whatsapp %>?text=<%= encodeURIComponent('Hi Cyberninja Innovations, I saw your work on the Victory Barbershop site and would like to talk about a project.') %>" target="_blank" rel="noopener" class="btn-ghost-light">WhatsApp us</a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="text-xs font-medium uppercase tracking-[0.24em] text-paper/50">What we build</p>
        <ul class="mt-5 grid gap-3 sm:grid-cols-2">
          <% c.services.forEach((s) => { %>
            <li class="studio-card">
              <span class="studio-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons[s.icon] %></svg></span>
              <span class="min-w-0">
                <span class="block font-medium text-paper"><%= s.title %></span>
                <span class="mt-1 block text-sm leading-relaxed text-paper/60"><%= s.text %></span>
              </span>
            </li>
          <% }) %>
        </ul>
        <div class="mt-6 flex flex-col gap-2 border-t border-paper/10 pt-5 text-sm text-paper/60 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6">
          <a href="mailto:<%= c.email %>" class="link-u break-all hover:text-paper"><%= c.email %></a>
          <a href="tel:<%= c.phone.replace(/\s/g, '') %>" class="link-u hover:text-paper"><%= c.phone %></a>
          <span><%= c.reach %></span>
        </div>
      </div>
    </div>
  </div>
</section>
