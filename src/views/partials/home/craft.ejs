<section id="craft" class="relative overflow-hidden py-24 lg:py-24">
  <div class="relative mx-auto max-w-[88rem] px-5 sm:px-8 lg:px-10">
    <figure class="relative overflow-hidden lg:absolute lg:inset-y-0 lg:right-10 lg:w-[44%]" data-clip>
      <img
        src="<%= imageUrl(siteImg('craftPortrait'), { w: 1300 }) %>" <%- imgSize(siteImg('craftPortrait'), { w: 1300 }) %>
        srcset="<%= srcset(siteImg('craftPortrait'), [700, 1300]) %>"
        sizes="(min-width: 1024px) 40vw, 92vw"
        alt="A client smiling after a fresh cut, lit warm against a dark backdrop"
        class="aspect-[4/5] h-full w-full object-cover sm:aspect-[16/11] lg:aspect-auto"
        loading="lazy"
        data-parallax-img
      />
    </figure>

    <div class="relative z-10 -mt-20 bg-surface p-6 shadow-[0_40px_90px_-50px_rgba(20,20,20,0.45)] sm:mx-6 sm:p-10 lg:mx-0 lg:my-16 lg:w-[66%] lg:p-14">
      <p class="eyebrow"><span class="eyebrow-num"><%= locals.sec ? sec() : '03' %></span>Craft comes first</p>
      <h2 class="mt-5 max-w-2xl text-[clamp(2rem,3.6vw,3.5rem)] leading-[1.04]" data-split><%- rich(copy.craftTitle) %></h2>

      <%# Two detail shots side by side with the note beneath; copy and the ring button on the right. %>
      <div class="mt-12 grid gap-10 md:grid-cols-[1.45fr_1fr] md:items-end lg:grid-cols-1 xl:grid-cols-[1.45fr_1fr]">
        <div>
        <div class="grid grid-cols-2 gap-3 sm:gap-4">
          <figure class="overflow-hidden" data-speed="0.08">
            <img
              src="<%= imageUrl(siteImg('craftA'), { w: 900 }) %>" <%- imgSize(siteImg('craftA'), { w: 900 }) %>
              srcset="<%= srcset(siteImg('craftA'), [500, 900]) %>"
              sizes="(min-width: 1280px) 18vw, (min-width: 768px) 26vw, 44vw"
              alt="Barber working a clipper over a client’s crown"
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
            />
          </figure>
          <figure class="overflow-hidden" data-speed="-0.06">
            <img
              src="<%= imageUrl(siteImg('craftB'), { w: 900 }) %>" <%- imgSize(siteImg('craftB'), { w: 900 }) %>
              srcset="<%= srcset(siteImg('craftB'), [500, 900]) %>"
              sizes="(min-width: 1280px) 18vw, (min-width: 768px) 26vw, 44vw"
              alt="The shop floor mid-afternoon, clients in the chair and waiting"
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
            />
          </figure>
        </div>
        <p class="mt-6 flex max-w-md items-start gap-3 text-sm leading-relaxed text-ink/65" data-reveal><span class="mt-[0.6rem] h-px w-8 shrink-0 bg-amber" aria-hidden="true"></span><%= copy.craftNote %></p>
        </div>
        <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-end lg:justify-between xl:flex-col xl:items-start" data-reveal>
          <p class="max-w-md text-sm leading-relaxed text-ink/75"><%= copy.craftText %></p>
          <%- include('../ring-btn', { href: '/book', label: ['Booking', 'now'], ring: 'Craft comes first · Book now · Craft comes first · ', tone: 'dark', id: 'craft' }) %>
        </div>
      </div>
    </div>
  </div>
</section>
