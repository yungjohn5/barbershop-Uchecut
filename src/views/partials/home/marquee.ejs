<% const items = [...categories.map((c) => c.name), 'Home visits', 'Lagos']; %>
<div class="relative mt-20 overflow-hidden border-y border-ink/10 py-6 lg:mt-28" aria-hidden="true">
  <div class="marquee" data-marquee>
    <% for (let copyIdx = 0; copyIdx < 2; copyIdx += 1) { %>
      <div class="flex shrink-0 items-center">
        <% items.forEach((item) => { %>
          <span class="whitespace-nowrap px-6 font-serif text-[2.2rem] leading-none sm:text-5xl lg:px-10 lg:text-6xl"><%= item %></span>
          <span class="text-xl text-amber sm:text-2xl">✦</span>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>
