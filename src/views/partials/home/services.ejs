<section id="services" class="relative bg-surface">
  <div class="mx-auto max-w-[88rem] px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow"><span class="eyebrow-num"><%= locals.sec ? sec() : '02' %></span>Service <span class="text-ink/65">· <%= services.length %> on the menu</span></p>
        <h2 class="mt-5 text-title" data-split><%- rich(copy.servicesTitle) %></h2>
      </div>
      <p class="max-w-md text-[1.02rem] leading-relaxed text-ink/70 lg:col-span-4 lg:col-start-9" data-reveal><%= copy.servicesText %></p>
    </div>

    <div class="no-scrollbar -mx-5 mt-12 overflow-x-auto px-5 sm:mx-0 sm:px-0">
      <div class="flex gap-7" role="group" aria-label="Filter services by category" data-svc-tabs>
        <button type="button" class="tab" aria-pressed="true" data-filter="all"><span class="dot" aria-hidden="true"></span>All<sup class="tab-count"><%= services.length %></sup></button>
        <% categories.forEach((c) => { %>
          <button type="button" class="tab" aria-pressed="false" data-filter="<%= c.slug %>"><span class="dot" aria-hidden="true"></span><%= c.name %><sup class="tab-count"><%= c.services.length %></sup></button>
        <% }) %>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 items-start gap-x-3 gap-y-12 sm:gap-x-5 md:grid-cols-3 xl:grid-cols-4 xl:gap-x-6" data-svc-grid>
      <% services.forEach((s, i) => { %>
        <a
          href="/book?type=SHOP&service=<%= s.id %>"
          class="svc-card group block <%= i % 2 === 1 ? 'offset-sm' : '' %> <%= i % 3 === 1 ? 'offset-md' : '' %>"
          data-category="<%= s.categorySlug %>"
          data-cursor="Book"
          data-reveal
        >
          <div class="relative overflow-hidden bg-paper-deep">
            <% if (imageOf(s)) { %>
              <img
                src="<%= imageUrl(imageOf(s), { w: 900 }) %>" <%- imgSize(imageOf(s), { w: 900 }) %>
                srcset="<%= srcset(imageOf(s), [500, 900, 1200]) %>"
                sizes="(min-width: 1280px) 22vw, (min-width: 768px) 30vw, 46vw"
                alt="<%= s.name %>"
                class="aspect-[4/5] w-full object-cover saturate-[0.8] transition-[transform,filter] duration-[1.2s] ease-expo group-hover:scale-[1.06] group-hover:saturate-100"
                loading="lazy"
              />
            <% } else { %>
              <div class="aspect-[4/5] w-full"></div>
            <% } %>
            <span class="card-shade" aria-hidden="true"></span>
            <span class="card-chip" aria-hidden="true"><span class="card-chip-label">Book this</span><span class="card-chip-arrow">→</span></span>
          </div>
          <div class="mt-3 flex items-baseline gap-2 text-[0.92rem] sm:justify-between sm:gap-3">
            <span class="tabular-nums text-ink/65"><%= pad2(i + 1) %>/</span>
            <span class="font-medium leading-snug sm:text-right"><%= s.name %></span>
          </div>
          <div class="mt-1 flex flex-col gap-0.5 text-sm text-ink/65 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-x-3">
            <span class="tabular-nums"><%= naira(s.priceKobo) %> · <%= duration(s.durationMin) %></span>
            <span><%= s.homeAvailable ? 'Shop or home' : 'In shop only' %></span>
          </div>
          <% if (s.description) { %><p class="mt-2 hidden max-w-[22rem] text-sm leading-relaxed text-ink/65 sm:block"><%= s.description %></p><% } %>
        </a>
      <% }) %>
    </div>
  </div>
</section>
