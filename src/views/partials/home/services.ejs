<section id="services" class="relative bg-white">
  <div class="mx-auto max-w-[88rem] px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow">Service</p>
        <h2 class="mt-5 text-title" data-split><%= copy.servicesTitle %></h2>
      </div>
      <p class="max-w-md text-[1.02rem] leading-relaxed text-ink/70 lg:col-span-4 lg:col-start-9" data-reveal><%= copy.servicesText %></p>
    </div>

    <div class="no-scrollbar -mx-5 mt-12 overflow-x-auto px-5 sm:mx-0 sm:px-0">
      <div class="flex gap-7" role="group" aria-label="Filter services by category" data-svc-tabs>
        <button type="button" class="tab" aria-pressed="true" data-filter="all"><span class="dot" aria-hidden="true"></span>All</button>
        <% categories.forEach((c) => { %>
          <button type="button" class="tab" aria-pressed="false" data-filter="<%= c.slug %>"><span class="dot" aria-hidden="true"></span><%= c.name %></button>
        <% }) %>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 items-start gap-x-3 gap-y-12 sm:gap-x-5 md:grid-cols-3" data-svc-grid>
      <% services.forEach((s, i) => { %>
        <a
          href="/book?type=SHOP&service=<%= s.id %>"
          class="svc-card group block <%= i % 2 === 1 ? 'offset-sm' : '' %> <%= i % 3 === 1 ? 'offset-md' : '' %>"
          data-category="<%= s.categorySlug %>"
          data-reveal
        >
          <div class="relative overflow-hidden bg-paper-deep">
            <% if (s.imageUrl) { %>
              <img
                src="<%= src(s.imageUrl, [500, 900]) %>"
                srcset="<%= srcset(s.imageUrl, [500, 900]) %>"
                sizes="(min-width: 768px) 30vw, 46vw"
                alt="<%= s.name %>"
                class="aspect-[4/5] w-full object-cover transition-transform duration-[1.2s] ease-expo group-hover:scale-[1.06]"
                loading="lazy"
              />
            <% } else { %>
              <div class="aspect-[4/5] w-full"></div>
            <% } %>
            <span class="absolute bottom-3 left-3 translate-y-2 rounded-full bg-paper px-3 py-1.5 text-xs font-medium opacity-0 transition-all duration-500 ease-expo group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100">Book this →</span>
          </div>
          <div class="mt-3 flex items-baseline justify-between gap-3 text-[0.92rem]">
            <span class="tabular-nums text-ink/45"><%= pad2(i + 1) %>/</span>
            <span class="text-right font-medium"><%= s.name %></span>
          </div>
          <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-3 text-sm text-ink/60">
            <span class="tabular-nums"><%= naira(s.priceKobo) %> · <%= duration(s.durationMin) %></span>
            <span><%= s.homeAvailable ? 'Shop or home' : 'In shop only' %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
