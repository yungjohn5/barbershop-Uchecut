<%#
  Layout by width:
    phones   stacked: heading, portrait, two insets, paragraph
    md–lg    two columns: heading, paragraph and insets beside a tall portrait
    xl+      the editorial collage from the reference, with construction lines
%>
<section id="intro" class="relative mx-auto max-w-[88rem] px-5 py-24 sm:px-8 lg:px-10 lg:py-32 xl:py-36">
  <%# Hairline grid, drawn on scroll (reference: thin construction lines through the collage). %>
  <div class="pointer-events-none absolute inset-y-16 left-1/3 hidden w-px origin-top hairline xl:block" data-line-y aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-16 left-2/3 hidden w-px origin-top hairline xl:block" data-line-y aria-hidden="true"></div>

  <div class="relative grid gap-10 md:grid-cols-2 md:gap-x-10 md:gap-y-8 lg:gap-x-16 xl:grid-cols-12 xl:grid-rows-[auto_1fr] xl:gap-x-8 xl:gap-y-10">
    <div class="md:col-start-1 md:row-start-1 xl:col-span-4 xl:col-start-9 xl:text-right">
      <p class="eyebrow"><span class="eyebrow-num">01</span>Intro</p>
      <h2 class="mt-5 text-title" data-split><%- rich(copy.introTitle) %></h2>
    </div>

    <figure class="relative overflow-hidden md:col-start-2 md:row-span-3 md:row-start-1 md:self-start xl:col-span-4 xl:col-start-5 xl:row-span-2 xl:self-stretch" data-clip>
      <img
        src="<%= imageUrl(siteImg('introPortrait'), { w: 1100 }) %>"
        srcset="<%= srcset(siteImg('introPortrait'), [600, 1100]) %>"
        sizes="(min-width: 1280px) 30vw, (min-width: 768px) 46vw, 92vw"
        alt="Profile portrait of a young man with a full, shaped afro"
        class="aspect-[3/4] h-full w-full object-cover"
        loading="lazy"
        data-parallax-img
      />
    </figure>

    <p class="max-w-md text-[1.02rem] leading-relaxed text-ink/75 md:col-start-1 md:row-start-2 xl:col-span-3 xl:row-start-2 xl:max-w-sm xl:self-end" data-reveal><%= copy.introText %></p>

    <div class="grid grid-cols-2 gap-4 md:col-start-1 md:row-start-3 md:self-end xl:contents">
      <figure class="overflow-hidden xl:col-span-3 xl:col-start-1 xl:row-start-1 xl:mt-4" data-speed="0.12">
        <img
          src="<%= imageUrl(siteImg('introTools'), { w: 900 }) %>"
          srcset="<%= srcset(siteImg('introTools'), [500, 900]) %>"
          sizes="(min-width: 1280px) 22vw, (min-width: 768px) 22vw, 45vw"
          alt="Clippers, trimmers, scissors and a brush laid out on the station"
          class="aspect-[4/5] w-full object-cover"
          loading="lazy"
        />
      </figure>
      <figure class="overflow-hidden xl:col-span-2 xl:col-start-11 xl:row-start-2 xl:self-end" data-speed="-0.1">
        <img
          src="<%= imageUrl(siteImg('introStill'), { w: 800 }) %>"
          srcset="<%= srcset(siteImg('introStill'), [400, 800]) %>"
          sizes="(min-width: 1280px) 15vw, (min-width: 768px) 22vw, 45vw"
          alt="Neck brush and tonic bottles at the barber’s station"
          class="aspect-[4/5] w-full object-cover"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
