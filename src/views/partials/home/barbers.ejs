<section id="barbers" class="relative bg-paper-deep">
  <div class="mx-auto max-w-[88rem] px-5 py-24 sm:px-8 lg:px-10 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="eyebrow"><span class="eyebrow-num">04</span>The barbers</p>
        <h2 class="mt-5 text-title" data-split><%- rich(copy.barbersTitle) %></h2>
      </div>
      <p class="max-w-md text-[1.02rem] leading-relaxed text-ink/70 lg:col-span-4 lg:col-start-9" data-reveal>
        Book a specific barber, or choose “any barber” and we’ll match you with whoever is free at your time.
      </p>
    </div>

    <div class="mt-16 grid gap-14 md:grid-cols-2 md:gap-8 lg:gap-12">
      <% barbers.forEach((b, i) => { %>
        <article class="group <%= i % 2 === 1 ? 'md:mt-28' : '' %>" data-reveal>
          <a href="/book?barber=<%= b.id %>" class="relative block overflow-hidden bg-ink/5" data-cursor="Book" aria-label="Book with <%= b.name %>">
            <% if (imageOf(b, 'photo')) { %>
              <img
                src="<%= imageUrl(imageOf(b, 'photo'), { w: 900 }) %>"
                srcset="<%= srcset(imageOf(b, 'photo'), [500, 900, 1200]) %>"
                sizes="(min-width: 768px) 44vw, 92vw"
                alt="Portrait of <%= b.name %>"
                class="aspect-[4/5] w-full object-cover object-top"
                loading="lazy"
                data-parallax-img
              />
            <% } else { %>
              <div class="aspect-[4/5] w-full"></div>
            <% } %>
            <% if (b.doesHomeService) { %>
              <span class="absolute left-4 top-4 rounded-full bg-paper/90 px-3 py-1.5 text-xs font-medium backdrop-blur">Does home visits</span>
            <% } %>
            <span class="card-shade" aria-hidden="true"></span>
            <span class="absolute inset-x-3 bottom-3 hidden translate-y-[130%] items-center justify-between rounded-full bg-paper/90 py-2 pl-5 pr-2 text-sm font-medium text-ink backdrop-blur transition-transform duration-700 ease-expo group-hover:translate-y-0 [@media(hover:hover)]:flex" aria-hidden="true">
              <span>Book with <%= b.name.split(' ')[0] %></span><span class="card-chip-arrow h-8 w-8">→</span>
            </span>
          </a>
          <div class="mt-5 flex items-baseline justify-between gap-4">
            <h3 class="text-[2.2rem] leading-none"><%= b.name %></h3>
            <span class="tabular-nums text-sm text-ink/65"><%= pad2(i + 1) %>/</span>
          </div>
          <% if (b.specialties && b.specialties.length) { %>
            <p class="mt-2 text-sm uppercase tracking-[0.14em] text-stone"><%= b.specialties.join(' · ') %></p>
          <% } %>
          <% if (b.bio) { %><p class="mt-4 max-w-md text-[1.02rem] leading-relaxed text-ink/75"><%= b.bio %></p><% } %>
          <a href="/book?barber=<%= b.id %>" class="link-line mt-4 text-[0.95rem]">
            Book with <%= b.name.split(' ')[0] %> <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
